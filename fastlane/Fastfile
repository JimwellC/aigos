opt_out_usage        # no anonymous analytics — this is a privacy-first project
default_platform(:ios)

# --- Shared config -----------------------------------------------------------
PROJECT    = "aigos.xcodeproj"
SCHEME     = "aigos"
OUTPUT_DIR = "./build/fastlane"
IPA_NAME   = "aigos.ipa"

platform :ios do
  # App Store Connect API key, built from env vars (loaded from fastlane/.env
  # locally, or from secrets in CI). Preferred over Apple-ID auth: no 2FA,
  # no expiring session, works headless. See fastlane/.env.template.
  def asc_api_key
    app_store_connect_api_key(
      key_id:                ENV.fetch("ASC_KEY_ID"),
      issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
      key_filepath:          ENV["ASC_KEY_PATH"],    # path to AuthKey_XXXXXX.p8
      key_content:           ENV["ASC_KEY_CONTENT"], # OR inline key content (CI)
      is_key_content_base64: ENV["ASC_KEY_IS_BASE64"] == "true",
      in_house:              false
    )
  end

  # Shared archive step. Build number comes from git commit count, injected at
  # build time via xcargs so nothing is written back into the tracked project.
  def archive
    build_app(
      project:          PROJECT,
      scheme:           SCHEME,
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: OUTPUT_DIR,
      output_name:      IPA_NAME,
      clean:            true,
      xcargs:           "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{number_of_commits}"
    )
  end

  # --- Testing ---------------------------------------------------------------
  desc "Run the unit-test suite on a simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme:  SCHEME,
      devices: ["iPhone 16"],
      clean:   true
    )
  end

  # --- Building --------------------------------------------------------------
  desc "Archive a signed App Store .ipa (no upload)"
  lane :build do
    archive
  end

  # --- TestFlight ------------------------------------------------------------
  desc "Build and upload a new build to TestFlight (internal testers)"
  lane :beta do
    key = asc_api_key
    archive
    upload_to_testflight(
      api_key:                           key,
      skip_waiting_for_build_processing: true,
      distribute_external:               false
    )
  end

  # --- App Store -------------------------------------------------------------
  desc "Build the binary and push metadata to App Store Connect (does NOT auto-submit)"
  lane :release do
    key = asc_api_key
    archive
    upload_to_app_store(
      api_key:                           key,
      submit_for_review:                 false, # flip to true once you've eyeballed the draft
      automatic_release:                 false,
      force:                             true,  # skip the HTML metadata-preview prompt
      run_precheck_before_submit:        true,
      precheck_include_in_app_purchases: false,
      skip_screenshots:                  true,  # no screenshots wired yet — see README
      skip_metadata:                     false
    )
  end

  # --- Metadata only ---------------------------------------------------------
  desc "Push only the listing metadata (name/subtitle/description/keywords/etc.) — no binary"
  lane :metadata do
    key = asc_api_key
    upload_to_app_store(
      api_key:                    key,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      force:                      true,
      run_precheck_before_submit: false
    )
  end
end
