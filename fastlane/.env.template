# App Store Connect API key credentials for fastlane.
# Copy this file to `fastlane/.env` (which is gitignored) and fill in the values.
#
# Create the key at:  App Store Connect → Users and Access → Integrations →
#                     App Store Connect API → generate an "App Manager" key.
# Download the AuthKey_XXXXXXXXXX.p8 ONCE (Apple won't let you re-download it)
# and store it OUTSIDE the repo, e.g. ~/.appstoreconnect/private_keys/.

ASC_KEY_ID=XXXXXXXXXX                                   # the Key ID (10 chars)
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx      # the Issuer ID (UUID, top of the Keys page)
ASC_KEY_PATH=/Users/jimwelllcalma/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# --- CI alternative (instead of ASC_KEY_PATH) ---
# Paste the .p8 contents directly (base64-encode it and set the flag):
# ASC_KEY_CONTENT=LS0tLS1CRUdJTi...
# ASC_KEY_IS_BASE64=true
