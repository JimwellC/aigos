# Deliverfile — defaults for `upload_to_app_store` (deliver).
# Auth (API key) and the per-lane flags live in the Fastfile; this file just
# pins the delivery-wide behaviour so every lane and a bare `fastlane deliver`
# agree.

# Where the listing text lives (default, kept explicit for clarity).
metadata_path("./fastlane/metadata")

# No screenshots wired up yet — add 6.7" PNGs under
# fastlane/screenshots/en-US/ and set this to false to push them.
skip_screenshots(true)

# One-time paid app, no IAP.
precheck_include_in_app_purchases(false)

# Never auto-submit from a bare deliver run; the `release` lane opts in explicitly.
submit_for_review(false)
automatic_release(false)
